<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fbf0de" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#17110e" media="(prefers-color-scheme: dark)">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Saxby design system tokens (light first, dark second) */
:root, [data-theme="light"] {
  color-scheme: light;
  --ground: #fbf0de; --panel: #fff8ec; --buff: #f4d3a1; --soot: #241a15;
  --soot-muted: #6a5849; --rule: #e3cba6; --track: #f0dfc4;
  --signal: #c8231a; --caution: #8f5e00;
  --label-stock: #c8231a; --label-ink: #fbf0de; --peach: #f4d3a1;
  --series-1: #c8231a; --series-2: #1f6046; --series-3: #1f4e7a;
  --series-4: #6189b4; --series-5: #6b4a7c; --series-6: #9a8b7e;
  --series-7: #8a7868; --series-8: #c9b49a; --on-series: #ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --ground: #17110e; --panel: #221914; --buff: #33261c; --soot: #f5e5cb;
    --soot-muted: #b8a38b; --rule: #3b2d23; --track: #2d221c;
    --signal: #ff6151; --caution: #f0b23a;
    --series-1: #ff6151; --series-2: #52b48a; --series-3: #6e9ed2;
    --series-4: #a9c7e7; --series-5: #b791cf; --series-6: #857668;
    --series-7: #6f604f; --series-8: #4a3b30; --on-series: #17110e;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --ground: #17110e; --panel: #221914; --buff: #33261c; --soot: #f5e5cb;
  --soot-muted: #b8a38b; --rule: #3b2d23; --track: #2d221c;
  --signal: #ff6151; --caution: #f0b23a;
  --series-1: #ff6151; --series-2: #52b48a; --series-3: #6e9ed2;
  --series-4: #a9c7e7; --series-5: #b791cf; --series-6: #857668;
  --series-7: #6f604f; --series-8: #4a3b30; --on-series: #17110e;
}
:root {
  /* older names the charts use, mapped onto Saxby tokens */
  --paper: var(--ground); --ink: var(--soot); --muted: var(--soot-muted);
  --heat: var(--soot); --heat-ink: var(--ground); --budget: var(--caution);
  --q38: var(--series-1); --gem: var(--series-2); --ls: var(--series-3);
  --lst: var(--series-4); --lxs: var(--series-5); --qcn: var(--series-6);
  --gra: var(--series-7); --bge: var(--series-8);
  --display: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --body: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
* { box-sizing: border-box; }
:root { box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px); }
html { background: var(--paper);
  scroll-padding-top: env(safe-area-inset-top, 0px); }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font: 400 18px/1.6 var(--body);
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}
main { max-width: 900px; margin: 0 auto; padding: 72px 28px 96px; }
h1, h2 { font-family: var(--display); font-weight: 700;
  letter-spacing: -0.01em; line-height: 1.05; margin: 0; }
h1 { font-size: clamp(44px, 7.4vw, 78px); max-width: 13ch; }
h2 { font-size: clamp(30px, 4.4vw, 42px); margin-top: 0; }
p { max-width: 66ch; margin: 0 0 1em; }
.deck { font-size: 21px; line-height: 1.55; color: var(--muted);
  margin-top: 28px; max-width: 58ch; }
.deck strong { color: var(--ink); font-weight: 600; }
section { padding-top: 76px; }
section > h2 + p { margin-top: 18px; }
.figure { background: var(--panel); border: 1px solid var(--rule);
  border-radius: 14px; padding: 28px 28px 22px; margin: 30px 0 0; }
.figcap { font-size: 15px; color: var(--muted); margin: 14px 0 0; }
.chart-title { font-weight: 600; font-size: 16px; margin: 0 0 18px; }
/* palette series: a page's data maps names to these numbers */
.c-1 { --c: var(--series-1); } .c-2 { --c: var(--series-2); }
.c-3 { --c: var(--series-3); } .c-4 { --c: var(--series-4); }
.c-5 { --c: var(--series-5); } .c-6 { --c: var(--series-6); }
.c-7 { --c: var(--series-7); } .c-8 { --c: var(--series-8); }

/* finish order */
.race { list-style: none; padding: 0; margin: 44px 0 0; }
.race-row { display: grid; align-items: center;
  grid-template-columns: 2.2em minmax(150px, 230px) 1fr 4.4em;
  gap: 14px; padding: 9px 0; border-top: 1px solid var(--rule); }
.race-row:last-child { border-bottom: 1px solid var(--rule); }
.race-rank { font: 700 26px/1 var(--display); color: var(--muted); }
.race-row:first-child .race-rank { color: var(--c); }
.race-name { font-weight: 600; line-height: 1.25; }
.race-name small { display: block; font-weight: 400; font-size: 14px;
  color: var(--muted); }
.race-track { height: 22px; background: var(--track); border-radius: 4px;
  overflow: hidden; }
.race-bar { display: block; height: 100%; width: var(--w);
  background: var(--c); border-radius: 4px;
  animation: grow 1.1s cubic-bezier(.2, .7, .2, 1) both; }
.race-row:nth-child(2) .race-bar { animation-delay: .08s; }
.race-row:nth-child(3) .race-bar { animation-delay: .16s; }
.race-row:nth-child(4) .race-bar { animation-delay: .24s; }
.race-row:nth-child(5) .race-bar { animation-delay: .32s; }
.race-row:nth-child(6) .race-bar { animation-delay: .40s; }
.race-val { font: 700 26px/1 var(--display); text-align: right; }
.race-val small { font-size: 16px; color: var(--muted); font-weight: 400; }
.race-note { font-size: 15px; color: var(--muted); margin-top: 12px; }
@keyframes grow { from { width: 0; } }

/* bars */
.bars-wrap { position: relative; }
.bars { list-style: none; padding: 0; margin: 0; }
.bar-row { display: grid; align-items: center;
  grid-template-columns: minmax(150px, 210px) 1fr 6.2em; gap: 14px;
  padding: 7px 0; }
.bar-name { font-weight: 600; font-size: 16px; }
.bar-track { height: 18px; background: var(--track); border-radius: 4px;
  overflow: hidden; }
.bar-fill { display: block; height: 100%; width: var(--w);
  background: var(--c); border-radius: 4px; }
.bar-val { text-align: right; font-weight: 600; }
.bar-row.over .bar-val { color: var(--budget); }
.has-budget .bar-track { position: relative; overflow: visible; }
.has-budget .bar-fill { position: relative; z-index: 0; }
.has-budget .bar-track::after { content: ""; position: absolute;
  top: -7px; bottom: -7px; left: var(--at);
  border-left: 2px dashed var(--budget); z-index: 1; }
.budget-head { padding: 0 0 4px; }
.budget-label { position: relative; height: 22px; display: block; }
.budget-label span { position: absolute; bottom: 2px;
  right: calc(100% - var(--at) + 8px); white-space: nowrap;
  font-size: 13px; font-weight: 600; color: var(--budget); }

/* svg charts */
.chart { width: 100%; height: auto; display: block; overflow: visible; }
.chart .grid { stroke: var(--rule); stroke-width: 1; }
.chart .tick { fill: var(--muted); font: 400 14px var(--body); }
.chart .axis { fill: var(--muted); font: 600 14px var(--body); }
.chart .bubble { fill: var(--c); fill-opacity: .18; stroke: var(--c);
  stroke-width: 1.5; }
.chart .dot { fill: var(--c); }
.chart .pt-label { fill: var(--ink); font: 600 16px var(--body);
  paint-order: stroke; stroke: var(--panel); stroke-width: 4px; }
.chart .pt-sub { fill: var(--muted); font: 400 13px var(--body); }
.heat .hm-task { fill: var(--ink); font: 600 15px var(--body); }
.heat .hm-model { fill: var(--ink); font: 600 14px var(--body); }
.heat .hm-model-2 { fill: var(--muted); font: 400 13px var(--body); }
.heat rect { fill: var(--heat); }
.heat .v0 rect { fill-opacity: .07; } .heat .v1 rect { fill-opacity: .3; }
.heat .v2 rect { fill-opacity: .62; } .heat .v3 rect { fill-opacity: .94; }
.heat .cell-main { font: 700 17px var(--body); fill: var(--ink); }
.heat .cell-sub { font: 400 12px var(--body); fill: var(--muted); }
.heat .v2 text, .heat .v3 text { fill: var(--heat-ink); }
.heat .v2 .cell-sub, .heat .v3 .cell-sub { fill-opacity: .82; }
.scroll { overflow-x: auto; }
.scroll .heat { min-width: 600px; }

/* stacked hot set */
.stack-row { display: grid; grid-template-columns: 4.6em 1fr 6.4em;
  gap: 14px; align-items: center; padding: 10px 0; }
.stack-label { font-weight: 600; }
.stack-track { display: flex; height: 38px; background: var(--track);
  border-radius: 5px; overflow: hidden; }
.seg { width: var(--w); background: var(--c); display: flex;
  align-items: center; padding-left: 8px; min-width: 2px;
  border-right: 2px solid var(--panel); }
.seg-text { color: #fff; font-size: 13.5px; font-weight: 600;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stack-val { font: 700 26px/1 var(--display); text-align: right; }
.stack-val small { font: 400 14px var(--body); color: var(--muted); }
.stack-key { font-size: 15px; color: var(--muted); margin: 10px 0 0; }

/* tables */
table { border-collapse: collapse; width: 100%; font-size: 16px; }
th, td { text-align: left; padding: 11px 12px 11px 0; vertical-align: top;
  border-top: 1px solid var(--rule); }
thead th { border-top: 0; color: var(--muted); font-weight: 600;
  font-size: 14px; }
.review th[scope="row"] { font-weight: 600; white-space: nowrap; }
.pill { display: inline-block; padding: 1px 10px; border-radius: 99px;
  background: var(--c); color: #fff; font-weight: 600; font-size: 14px; }
.full { font-size: 15px; }
.full td, .full th { white-space: nowrap; padding-right: 14px; }
.swatch { display: inline-block; width: 10px; height: 10px;
  border-radius: 2px; background: var(--c); margin-right: 8px; }
.score { font: 700 clamp(60px, 10vw, 104px)/1 var(--display);
  margin: 26px 0 6px; }
.score span { color: var(--muted); font-weight: 400; }

/* takeaways */
.lessons { list-style: none; padding: 0; margin: 26px 0 0;
  display: grid; gap: 0; }
.lessons li { padding: 18px 0; border-top: 1px solid var(--rule);
  display: grid; grid-template-columns: minmax(180px, 250px) 1fr;
  gap: 20px; }
.lessons li:last-child { border-bottom: 1px solid var(--rule); }
.lessons b { font: 700 24px/1.15 var(--display); }
.lessons span { color: var(--muted); }
.callout { border-left: 4px solid var(--q38); padding: 4px 0 4px 20px;
  margin: 26px 0 0; }
.callout p:last-child { margin-bottom: 0; }
footer { margin-top: 84px; padding-top: 22px; border-top: 1px solid
  var(--rule); font-size: 14px; color: var(--muted); }
footer p { max-width: none; }
a { color: inherit; text-underline-offset: 3px; }
a:focus-visible { outline: 3px solid var(--q38); outline-offset: 2px; }
code { font-size: .9em; }

@media (max-width: 640px) {
  body { font-size: 17px; }
  main { padding: 44px 18px 72px; }
  .race-row { grid-template-columns: 1.6em 1fr 3.6em; }
  .race-track { grid-column: 2 / 4; grid-row: 2; }
  .bar-row { grid-template-columns: 1fr 5.4em; }
  .bar-track { grid-column: 1 / 3; grid-row: 2; }
  .budget-head { display: none; }
  .lessons li { grid-template-columns: 1fr; gap: 6px; }
  .figure { padding: 20px 16px 16px; }
}

/* persona chart */
.persona { list-style: none; padding: 0; margin: 0; }
.p-row { display: grid; grid-template-columns: minmax(150px, 230px) 1fr;
  gap: 16px; padding: 14px 0; border-top: 1px solid var(--rule);
  align-items: center; }
.p-row:first-child { border-top: 0; }
.p-label { font-weight: 600; line-height: 1.3; }
.p-row.flag .p-label { color: var(--q38); }
.p-bars { display: grid; gap: 6px; }
.p-bar { display: grid; grid-template-columns: 4.6em 1fr 4.2em; gap: 10px;
  align-items: center; font-size: 15px; }
.p-name { color: var(--muted); }
.p-track { height: 14px; background: var(--track); border-radius: 3px;
  overflow: hidden; }
.p-fill { display: block; height: 100%; width: var(--w);
  background: var(--c); border-radius: 3px; }
.p-val { text-align: right; font-weight: 600; }
.p-val small { color: var(--muted); font-weight: 400; }

/* fun fact */
.funfact { margin: 34px 0 0; padding: 22px 24px; border-radius: 14px;
  border: 2px dashed var(--ls); background: var(--panel); }
.funfact h3 { font: 700 24px/1.15 var(--display); margin: 0 0 10px; }
.funfact p { font-size: 17px; }
.funfact p:last-child { margin-bottom: 0; }
h3.sub { font: 700 26px/1.1 var(--display); margin: 40px 0 14px; }

@media (max-width: 640px) {
  .p-row { grid-template-columns: 1fr; gap: 8px; }
}

/* two judges */
.judges { display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  margin: 28px 0 28px; }
.judge { background: var(--panel); border: 1px solid var(--rule);
  border-radius: 14px; padding: 20px 22px; }
.judge p.score { font: 700 clamp(56px, 8vw, 88px)/1 var(--display);
  color: var(--ink); margin: 0 0 12px; }
.judge p.score span { color: var(--muted); font-weight: 400; }
.judge p { font-size: 16px; color: var(--muted); margin: 0; }
.judge b { color: var(--ink); }
.review tr.split th, .review tr.split td { background:
  color-mix(in srgb, var(--ls) 9%, transparent); }
.review .conf { display: block; font-size: 13px; color: var(--muted);
  margin-top: 4px; white-space: nowrap; }
.review td:nth-child(2), .review td:nth-child(3) { white-space: nowrap; }
@media (max-width: 640px) { .judges { grid-template-columns: 1fr; } }

/* ---- Saxby skin ---- */
body { font-family: var(--body); font-stretch: 100%; }
h1, h2, h3 { font-family: var(--display); }
h2 { font-weight: 800; font-stretch: 108%; letter-spacing: -0.005em; }
section > h2::before { content: ""; display: block; width: 48px; height: 4px;
  background: var(--signal); margin-bottom: 20px; }
code, .race-rank, .race-val, .bar-val, .stack-val, .p-val, .conf,
.full td { font-family: var(--mono); }
.race-val, .stack-val { font-size: 22px; font-weight: 600; }
.race-rank { font-size: 18px; font-weight: 600; }
.race-row:first-child .race-rank { color: var(--signal); }
.deck strong { color: var(--soot); }

/* the Label: the signature, once per page */
.sx-label { position: relative; background: var(--label-stock);
  color: var(--label-ink); text-align: center;
  padding: 40px 36px 34px; max-width: 100%; }
.sx-label p { margin: 0; max-width: none; }
.sx-label__no { position: absolute; top: 14px; right: 16px;
  font: 500 12px/1 var(--mono); letter-spacing: .04em; }
.sx-label__title { margin: 0; font-weight: 400; max-width: none;
  font-size: inherit; line-height: inherit; }
.sx-label__top, .sx-label__bottom { display: block; font: 700 20px/1.2
  var(--display); font-stretch: 115%; letter-spacing: .14em;
  text-transform: uppercase; }
.sx-label__top::after { content: ""; display: block; width: 136px;
  height: 3px; margin: 14px auto 10px; background: var(--label-ink); }
.sx-label__word { display: block; font: 900 min(120px, 12.5vw)/.92
  var(--display); white-space: nowrap; font-stretch: 118%;
  text-transform: uppercase; letter-spacing: -.01em; }
.sx-label .sx-label__bottom { margin-top: 14px; }
.deck { margin-top: 32px; }
@media (max-width: 640px) {
  .sx-label { padding: 36px 14px 22px; }
  .sx-label__no { top: 12px; right: 12px; }
  .sx-label__top, .sx-label__bottom { font-size: 17px; letter-spacing: .12em; }
  .sx-label__top::after { width: 96px; margin: 10px auto 8px; }
  .sx-label .sx-label__bottom { margin-top: 10px; }
}

/* viewport floor: 320px and up never scrolls sideways; below it, scroll */
html, body { min-width: 320px; overflow-x: hidden; overflow-x: clip; }
@media (max-width: 319px) {
  html, body { overflow-x: auto; }
  .sx-fixed { position: absolute; max-width: 100%; }
}

/* notice: the fun fact */
.funfact { border: 2px solid var(--signal); border-radius: 0;
  background: var(--panel); }
.funfact h3 { font-weight: 800; font-stretch: 108%; }
.funfact .sx-kicker { display: block; font: 700 13px/1.2 var(--display);
  font-stretch: 115%; letter-spacing: .14em; text-transform: uppercase;
  color: var(--signal); margin-bottom: 10px; }

/* bulletin: the cooling-rack box */
.callout { border-left: 0; border-top: 6px solid var(--signal);
  background: var(--buff); padding: 22px 24px; }

/* panels and pills */
.figure { border-radius: 8px; }
.judge { border-radius: 8px; }
.judge p.score { font-weight: 900; font-stretch: 118%; }
.pill { border-radius: 3px; color: var(--on-series);
  font: 600 13px/1.6 var(--mono); padding: 0 8px; }
.seg-text { color: var(--on-series); font-family: var(--mono); }
h3.sub { font-weight: 800; font-stretch: 108%; }
.lessons b { font-weight: 800; font-stretch: 108%; }
.sx-colophon { font-family: var(--mono); font-size: 13px;
  letter-spacing: .02em; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap; }
@media (prefers-reduced-motion: reduce) {
  .race-bar { animation: none; }
}

/* a paragraph right after a chart, such as round 2's rule */
.figure + p { margin-top: 26px; }
</style>
</head>
<%
  // The Markdown renders flat. Sort it the way the report is built:
  // everything before the first h2 is the header, each h2 starts a
  // section, and the footer block comes last on its own.
  const marked = content.replace(/<h3>/g, '<h3 class="sub">');
  const footer = (marked.match(/<footer>[\s\S]*?<\/footer>/) ?? [""])[0];
  const [header, ...sections] = marked
    .replace(footer, "")
    .split(/(?=<h2[\s>])/);
-%>
<body>
<main>

  <header>
<%- header.trim() %>
  </header>
<% for (const section of sections) { -%>

  <section>
<%- section.trim() %>
  </section>
<% } -%>

<%- footer %>

</main>
</body>
</html>
