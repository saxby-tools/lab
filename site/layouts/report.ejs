<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<%- include("head.ejs") %>
</head>
<%
  // The Markdown renders flat. Sort it the way the report is built:
  // everything before the first h2 is the header, each h2 starts a
  // section, and the footer block comes last on its own.
  const marked = content.replace(/<h3>/g, '<h3 class="sub">');
  const footer = (marked.match(/<footer>[\s\S]*?<\/footer>/) ?? [""])[0];
  const [header, ...sections] = marked
    .replace(footer, "")
    .split(/(?=<h2[\s>])/);
-%>
<body class="layout-report">
<%- include("top.ejs") -%>
<main>

  <header>
<%- header.trim() %>
  </header>
<% for (const section of sections) { -%>

  <section>
<%- section.trim() %>
  </section>
<% } -%>

<%- footer %>

</main>
</body>
</html>
