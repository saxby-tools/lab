<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fbf0de" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#17110e" media="(prefers-color-scheme: dark)">
<%- include("head.ejs") %>
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Saxby design system tokens (light first, dark second) */
:root, [data-theme="light"] {
  color-scheme: light;
  --ground: #fbf0de; --panel: #fff8ec; --buff: #f4d3a1; --soot: #241a15;
  --soot-muted: #6a5849; --rule: #e3cba6; --track: #f0dfc4;
  --signal: #c8231a; --caution: #8f5e00;
  --label-stock: #c8231a; --label-ink: #fbf0de;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --ground: #17110e; --panel: #221914; --buff: #33261c; --soot: #f5e5cb;
    --soot-muted: #b8a38b; --rule: #3b2d23; --track: #2d221c;
    --signal: #ff6151; --caution: #f0b23a;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --ground: #17110e; --panel: #221914; --buff: #33261c; --soot: #f5e5cb;
  --soot-muted: #b8a38b; --rule: #3b2d23; --track: #2d221c;
  --signal: #ff6151; --caution: #f0b23a;
}
:root {
  --display: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-6: 24px;
  --space-8: 32px; --space-12: 48px; --space-18: 72px;
  --radius-sm: 3px; --radius-md: 8px;
}

/* base */
*, *::before, *::after { box-sizing: border-box; }
:root { padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px); }
html { background: var(--ground);
  scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 24px); }
@media (prefers-reduced-motion: no-preference) {
  html { scroll-behavior: smooth; }
}

/* width floor: 320px and up never scrolls sideways; below it, scroll */
html, body { min-width: 320px; overflow-x: hidden; overflow-x: clip; }
@media (max-width: 319px) {
  html, body { overflow-x: auto; }
  .sx-fixed { position: absolute; max-width: 100%; }
}

body { margin: 0; background: var(--ground); color: var(--soot);
  font: 400 18px/1.6 var(--display); -webkit-font-smoothing: antialiased; }
main { max-width: 900px; margin: 0 auto; padding: 72px 28px 96px; }
p { margin: 0 0 1em; max-width: 66ch; }
a { color: inherit; text-decoration-color: var(--signal);
  text-decoration-thickness: 2px; text-underline-offset: 4px; }
a:hover { color: var(--signal); }
a:focus-visible, button:focus-visible { outline: 3px solid var(--signal);
  outline-offset: 3px; border-radius: 2px; }
code { font: 500 .88em/1.4 var(--mono); }

/* the Label: the signature, once per page */
.sx-label { position: relative; background: var(--label-stock);
  color: var(--label-ink); text-align: center; padding: 40px 36px 34px; }
.sx-label p { margin: 0; max-width: none; }
.sx-label__no { position: absolute; top: 14px; right: 16px;
  font: 500 12px/1 var(--mono); letter-spacing: .04em; }
.sx-label__title { margin: 0; font-weight: 400; font-size: inherit;
  line-height: inherit; }
.sx-label__top, .sx-label__bottom { display: block; font: 700 20px/1.2
  var(--display); font-stretch: 115%; letter-spacing: .14em;
  text-transform: uppercase; }
.sx-label__top::after { content: ""; display: block; width: 136px;
  height: 3px; margin: 14px auto 10px; background: var(--label-ink); }
.sx-label__word { display: block; font: 900 min(160px, 22vw)/.9
  var(--display); white-space: nowrap; font-stretch: 118%;
  text-transform: uppercase; letter-spacing: -.01em; }
.sx-label .sx-label__bottom { margin-top: 14px; }

.deck { margin-top: 32px; font-size: 21px; line-height: 1.55;
  color: var(--soot-muted); max-width: 58ch; }
.deck strong { color: var(--soot); font-weight: 600; }

/* contents */
.contents { margin-top: 44px; border-top: 2px solid var(--soot); }
.contents h2 { margin: 14px 0 6px; font: 600 15px/1.3 var(--display);
  color: var(--soot-muted); }
.contents ul { list-style: none; margin: 0; padding: 0;
  columns: 2; column-gap: 32px; }
.contents li { break-inside: avoid; border-bottom: 1px solid var(--rule); }
.contents a { display: block; padding: 10px 0; text-decoration: none;
  font-weight: 600; }
.contents a:hover { color: var(--signal); }

/* sections */
section { padding-top: 76px; }
section > h2 { margin: 0 0 18px; font: 800 clamp(30px, 4.4vw, 42px)/1.05
  var(--display); font-stretch: 108%; letter-spacing: -.005em; }
section > h2::before { content: ""; display: block; width: 48px;
  height: 4px; background: var(--signal); margin-bottom: 20px; }

/* reports */
.reports { list-style: none; margin: 26px 0 0; padding: 0; }
.report { display: grid; grid-template-columns: auto 1fr; gap: 6px 28px;
  align-items: start; padding: 24px 0; border-top: 2px solid var(--soot);
  border-bottom: 1px solid var(--rule); }
.report__no { grid-row: 1 / 4; margin: 0; color: var(--signal);
  font: 900 72px/.9 var(--display); font-stretch: 118%;
  font-variant-numeric: tabular-nums; }
.report__no span { display: block; font: 600 13px/1.2 var(--display);
  color: var(--soot-muted); margin-bottom: 6px; font-stretch: 100%; }
.report__title { margin: 0; font: 800 28px/1.15 var(--display);
  font-stretch: 108%; }
.report__title a { text-decoration: none; }
.report__title a:hover { text-decoration: underline;
  text-decoration-color: var(--signal); }
.report__meta { margin: 0; color: var(--soot-muted); font-size: 16px; }
.report__summary { margin: 4px 0 0; }
.report__links { display: flex; flex-wrap: wrap; gap: 10px 22px;
  margin: 10px 0 0; padding: 0; list-style: none; font-weight: 600; }

/* report folder layout */
.tree { list-style: none; margin: 24px 0 0; padding: 0; }
.tree__root { margin: 24px 0 0; font: 600 16px/1.4 var(--mono); }
.tree li { display: grid; grid-template-columns: minmax(170px, 230px) 1fr;
  gap: 4px 20px; padding: 12px 0 12px 22px; position: relative;
  border-bottom: 1px solid var(--rule); }
.tree li::before { content: ""; position: absolute; left: 4px; top: 0;
  bottom: 0; border-left: 2px solid var(--rule); }
.tree li::after { content: ""; position: absolute; left: 4px; top: 24px;
  width: 11px; border-top: 2px solid var(--rule); }
.tree li:last-child::before { bottom: auto; height: 25px; }
.tree code { font-weight: 600; font-size: 15px; }
.tree span { color: var(--soot-muted); font-size: 16px; }

/* bulletin: corrections */
.sx-bulletin { background: var(--buff); border-top: 6px solid var(--signal);
  padding: 22px 24px; margin-top: 24px; }
.sx-bulletin p:last-child { margin-bottom: 0; }

/* notice: the canary */
.sx-notice { background: var(--panel); border: 2px solid var(--signal);
  padding: 22px 24px; margin-top: 24px; }
.sx-notice__kicker { display: block; margin: 0 0 10px; color: var(--signal);
  font: 700 13px/1.2 var(--display); font-stretch: 115%;
  letter-spacing: .14em; text-transform: uppercase; }
.sx-notice p:last-child { margin-bottom: 0; }
.canary { margin: 0 0 16px; padding: 16px 18px; background: var(--ground);
  border: 1px solid var(--rule); border-radius: var(--radius-sm);
  overflow-x: auto; font: 500 14px/1.6 var(--mono); white-space: pre; }
.copy { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px;
  padding: 8px 14px; border: 2px solid var(--soot); border-radius: var(--radius-sm);
  background: transparent; color: var(--soot); cursor: pointer;
  font: 600 15px/1.2 var(--display); }
.copy:hover { background: var(--soot); color: var(--ground); }
.copy[data-state="done"] { border-color: var(--signal); color: var(--signal); }
.copy[data-state="done"]:hover { background: transparent; }

/* licenses */
.licenses { margin: 24px 0 0; padding: 0; list-style: none; }
.licenses li { display: grid; grid-template-columns: minmax(170px, 230px) 1fr;
  gap: 4px 20px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
.licenses li:first-child { border-top: 2px solid var(--soot); }
.licenses b { font-weight: 700; }
.licenses span { color: var(--soot-muted); }

footer { margin-top: 84px; padding-top: 22px; border-top: 1px solid var(--rule);
  font-size: 15px; color: var(--soot-muted); }
footer p { max-width: none; }

/* small screens */
@media (max-width: 640px) {
  body { font-size: 17px; }
  main { padding: 40px 18px 72px; }
  .sx-label { padding: 36px 14px 22px; }
  .sx-label__no { top: 12px; right: 12px; }
  .sx-label__top, .sx-label__bottom { font-size: 17px; letter-spacing: .12em; }
  .sx-label__top::after { width: 96px; margin: 10px auto 8px; }
  .sx-label .sx-label__bottom { margin-top: 10px; }
  .deck { font-size: 19px; }
  .contents ul { columns: 1; }
  .report { grid-template-columns: 1fr; }
  .report__no { grid-row: auto; font-size: 56px; }
  .tree li, .licenses li { grid-template-columns: 1fr; }
  section { padding-top: 60px; }
}
</style>
</head>
<%
  // The Markdown renders flat. Everything before the first h2 is the
  // header; each h2 starts a section. Anchors follow GitHub's heading
  // slugs, so the same #links work on GitHub and here. The contents
  // list is built from the headings, the one place this page bends the
  // plain-Markdown rule.
  const slug = (text) => text
    .replace(/<[^>]+>/g, "")
    .replace(/&[a-z0-9#]+;/gi, "")
    .toLowerCase()
    .replace(/[^a-z0-9 -]/g, "")
    .trim()
    .replace(/ /g, "-");
  const footer = (content.match(/<footer>[\s\S]*?<\/footer>/) ?? [""])[0];
  const [header, ...parts] = content
    .replace(footer, "")
    .split(/(?=<h2[\s>])/);
  const sections = parts.map((part) => {
    const heading = part.match(/<h2>([\s\S]*?)<\/h2>/)[1];

    return {
      id: slug(heading),
      heading,
      body: part.replace(/<h2>[\s\S]*?<\/h2>\n?/, "").trim(),
    };
  });
-%>
<body>
<main>

  <header>
<%- header.trim() %>

    <nav class="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">On this page</h2>
      <ul>
<% for (const section of sections) { -%>
        <li><a href="#<%= section.id %>"><%- section.heading %></a></li>
<% } -%>
      </ul>
    </nav>
  </header>
<% for (const section of sections) { -%>

  <section id="<%= section.id %>"
    aria-labelledby="<%= section.id %>-title">
    <h2 id="<%= section.id %>-title"><%- section.heading %></h2>
<%- section.body %>
  </section>
<% } -%>

<%- footer %>

</main>
<script>
  for (const button of document.querySelectorAll("[data-copy]")) {
    button.addEventListener("click", async () => {
      const source = document.getElementById(button.dataset.copy);
      try {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = "Copied";
        button.dataset.state = "done";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(source);
        const selection = getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        button.textContent = "Selected. Copy with Ctrl+C or Cmd+C";
      }
      setTimeout(() => {
        button.textContent = "Copy canary";
        delete button.dataset.state;
      }, 2400);
    });
  }
</script>
</body>
</html>
