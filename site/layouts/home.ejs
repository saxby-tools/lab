<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<%- include("head.ejs") %>
</head>
<%
  // The Markdown renders flat. Everything before the first h2 is the
  // header; each h2 starts a section. Anchors follow GitHub's heading
  // slugs, so the same #links work on GitHub and here. The contents
  // list is built from the headings, the one place this page bends the
  // plain-Markdown rule.
  const slug = (text) => text
    .replace(/<[^>]+>/g, "")
    .replace(/&[a-z0-9#]+;/gi, "")
    .toLowerCase()
    .replace(/[^a-z0-9 -]/g, "")
    .trim()
    .replace(/ /g, "-");
  const footer = (content.match(/<footer>[\s\S]*?<\/footer>/) ?? [""])[0];
  const [header, ...parts] = content
    .replace(footer, "")
    .split(/(?=<h2[\s>])/);
  const sections = parts.map((part) => {
    const heading = part.match(/<h2>([\s\S]*?)<\/h2>/)[1];

    return {
      id: slug(heading),
      heading,
      body: part.replace(/<h2>[\s\S]*?<\/h2>\n?/, "").trim(),
    };
  });
-%>
<body class="layout-home">
<%- include("top.ejs") -%>
<main>

  <header>
<%- header.trim() %>

    <nav class="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">On this page</h2>
      <ul>
<% for (const section of sections) { -%>
        <li><a href="#<%= section.id %>"><%- section.heading %></a></li>
<% } -%>
      </ul>
    </nav>
  </header>
<% for (const section of sections) { -%>

  <section id="<%= section.id %>"
    aria-labelledby="<%= section.id %>-title">
    <h2 id="<%= section.id %>-title"><%- section.heading %></h2>
<%- section.body %>
  </section>
<% } -%>

<%- footer %>

</main>
</body>
</html>
