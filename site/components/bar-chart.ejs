<div class="figure">
<% if (title) { -%>
  <p class="chart-title"><%= title %></p>
<% } -%>
<% if (marker) { -%>
  <div class="bars-wrap has-budget" style="--at:<%= marker.percent %>%">
  <div class="bar-row budget-head"><span></span><span
    class="budget-label"><span><%= marker.label %></span></span><span
    ></span></div>
<% } else { -%>
  <div class="bars-wrap">
<% } -%>
  <ol class="bars">
<% for (const row of rows) { -%>
  <li class="bar-row <%= row.series %><%= row.over ? " over" : "" %>">
    <span class="bar-name"><%= row.name %></span>
    <span class="bar-track"><span class="bar-fill"
      style="--w:<%= row.percent %>%"></span></span>
    <span class="bar-val"><%= row.text %></span>
  </li>
<% } -%>
  </ol></div>
<% if (tableHtml) { -%>
  <details class="figure-data">
    <summary>The numbers as a table</summary>
<%- tableHtml %>
  </details>
<% } -%>
<% if (caption) { -%>
<%- caption.replace("<p>", '<p class="figcap">') %>
<% } -%>
</div>
